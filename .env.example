HOMEBRIDGE_URL=http://localhost:8581
# Either an API token (Glass UI hbg_…)…
# HOMEBRIDGE_TOKEN=hbg_xxx
# …or a UI login
HOMEBRIDGE_USERNAME=admin
HOMEBRIDGE_PASSWORD=admin
# Optional
# HOMEBRIDGE_READ_ONLY=true
# HOMEBRIDGE_TIMEOUT_MS=30000
# Required for `homebridge-ai-kit mcp --http`
# HOMEBRIDGE_AI_MCP_TOKEN=change-me
