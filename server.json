{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.mp-consulting/homebridge-ai-kit",
  "title": "Homebridge",
  "description": "Control Homebridge accessories and scenes, manage plugins and config.json, and read logs",
  "repository": {
    "url": "https://github.com/mp-consulting/homebridge-ai-kit",
    "source": "github"
  },
  "websiteUrl": "https://github.com/mp-consulting/homebridge-ai-kit",
  "version": "__VERSION__",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@mp-consulting/homebridge-ai-kit",
      "version": "__VERSION__",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ],
      "environmentVariables": [
        {
          "name": "HOMEBRIDGE_URL",
          "description": "Homebridge UI URL, e.g. http://192.168.1.100:8581",
          "isRequired": true
        },
        {
          "name": "HOMEBRIDGE_TOKEN",
          "description": "Homebridge UI API token (Glass UI, hbg_…); replaces username and password",
          "isSecret": true
        },
        {
          "name": "HOMEBRIDGE_USERNAME",
          "description": "Homebridge UI username, when no token is set"
        },
        {
          "name": "HOMEBRIDGE_PASSWORD",
          "description": "Homebridge UI password, when no token is set",
          "isSecret": true
        },
        {
          "name": "HOMEBRIDGE_READ_ONLY",
          "description": "true registers only read-only tools"
        }
      ]
    },
    {
      "registryType": "mcpb",
      "identifier": "https://github.com/mp-consulting/homebridge-ai-kit/releases/download/v__VERSION__/homebridge-ai-kit-__VERSION__.mcpb",
      "version": "__VERSION__",
      "fileSha256": "__SHA256__",
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
