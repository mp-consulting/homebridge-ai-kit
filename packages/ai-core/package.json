{
  "name": "@mp-consulting/homebridge-ai-core",
  "version": "2.0.1",
  "description": "Slim AI core for Homebridge plugins \u2014 provider adapters (Anthropic, OpenAI, Gemini, OpenAI-compatible), secret redaction, prompts, Assistant features and the plugin settings UI routes. No MCP dependencies.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin/index.d.ts",
      "default": "./dist/plugin/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.test.json",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "homebridge",
    "homekit",
    "smart-home",
    "ai",
    "llm",
    "claude",
    "anthropic",
    "openai",
    "gemini"
  ],
  "author": "MP Consulting",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mp-consulting/homebridge-ai-kit.git",
    "directory": "packages/ai-core"
  },
  "funding": {
    "type": "paypal",
    "url": "https://paypal.me/mickaelpalma"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "ajv": "^8.20.0"
  },
  "engines": {
    "node": "^22.10.0 || ^24.0.0 || ^26.0.0"
  }
}
