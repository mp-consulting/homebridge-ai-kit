{
  "name": "@mp-consulting/homebridge-ai-kit",
  "version": "2.0.0",
  "description": "AI toolkit for Homebridge — an MCP server that lets AI assistants control accessories, manage plugins and monitor Homebridge, plus the shared AI building blocks used by Homebridge Glass UI and MP Consulting plugins.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "default": "./dist/mcp/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "homebridge-ai-kit": "dist/bin/homebridge-ai-kit.js",
    "homebridge-mcp-server": "dist/bin/homebridge-mcp-server.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/bin/homebridge-ai-kit.ts mcp",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.test.json",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "homebridge",
    "homebridge-plugin",
    "homekit",
    "smart-home",
    "ai",
    "llm",
    "mcp",
    "model-context-protocol",
    "claude",
    "anthropic"
  ],
  "author": "MP Consulting",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mp-consulting/homebridge-ai-kit.git"
  },
  "funding": {
    "type": "paypal",
    "url": "https://paypal.me/mickaelpalma"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.5.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": "^22.10.0 || ^24.0.0 || ^26.0.0"
  }
}
